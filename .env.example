# Salin berkas ini menjadi .env lalu isi semua nilai yang dibutuhkan.
# Kosongkan yang tidak wajib. Tanpa .env (atau dengan nilai wajib yang kosong),
# container menolak start, tidak ada kredensial bawaan yang published.

# Port web (nginx + frontend) yang di-expose di host.
WEB_PORT=

# --- Database (wajib; dipakai container postgres dan api) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Secret JWT access token (WAJIB) ---
# Isi string acak panjang. Contoh membuat:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=

# Opsional, bawaan 15m / 7.
JWT_ACCESS_TTL=
JWT_REFRESH_TTL_DAYS=

# Set true hanya jika aplikasi disajikan lewat HTTPS. Opsional, bawaan false.
COOKIE_SECURE=

# Batas unggah berkas (MB). Opsional, bawaan 25.
MAX_UPLOAD_MB=25

# --- Akun admin awal (dibuat saat seed pertama kali) ---
# (minimal 8 karakter, memuat huruf dan angka).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Log level API: debug | info | warn | error. Opsional, bawaan info.
LOG_LEVEL=

# --- Monitoring opsional (profil "monitoring") ---
# Nama GF_* dipakai langsung oleh image Grafana lewat env_file.
PROMETHEUS_PORT=
GRAFANA_PORT=
GF_SECURITY_ADMIN_USER=
GF_SECURITY_ADMIN_PASSWORD=
